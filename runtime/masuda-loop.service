[Unit]
Description=masuda self-loop entrypoint (VM boot path, Issue #31 M5-1)
# entrypoint.sh assumes /workspace and /masuda-state are already populated
# (it never mounts anything itself -- under Docker, dockerd's bind mount is
# already in place before ENTRYPOINT runs). Under systemd, the equivalent
# guarantee is these two virtiofs mount units finishing first.
#
# masuda-secrets.mount (Issue #31 M5-6, the claude-oauth-token share) is
# deliberately After= only, not Requires=: VMBackend.Start only attaches
# that virtiofs tag when a token has actually been registered
# (`masuda internal claude-token set`), so this mount legitimately fails
# (nofail, see runtime/fstab.vm) on a host that hasn't set one up yet --
# that must not block the whole loop from starting.
After=network.target workspace.mount masuda\x2dstate.mount masuda\x2dsecrets.mount
Requires=workspace.mount masuda\x2dstate.mount

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/workspace
ExecStart=/opt/masuda/runtime/entrypoint.sh
Restart=no

[Install]
WantedBy=multi-user.target
