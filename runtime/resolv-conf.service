[Unit]
Description=Point /etc/resolv.conf at systemd-resolved's stub (Issue #11/#31)
# /etc/resolv.conf as baked into the Docker image is whatever Docker Engine
# wrote into the *build host's* container filesystem at `docker build`
# time ("# Generated by Docker Engine", a nameserver address scoped to
# that build host's own network namespace -- confirmed live to be WSL2's
# internal NAT DNS proxy, unreachable from anywhere else). Harmless for
# the Docker path (dockerd bind-mounts over it on every `docker run`, so
# the baked-in content never actually gets used there), but VMBackend's
# rootfs *is* this baked-in filesystem verbatim -- nothing re-mounts
# /etc/resolv.conf at VM boot, so without this unit the guest can resolve
# nothing outside the bridge subnet.
#
# Can't fix this in the Dockerfile itself: `docker build`'s own build
# container bind-mounts /etc/resolv.conf, so even `rm -f` inside a RUN
# step fails with "Device or resource busy" (confirmed live). Has to
# happen after the image is running as an actual VM instead.
#
# systemd-networkd's DHCP client (runtime/vm-dhcp.network) already feeds
# the DNS server it learns (the bridge gateway IP) into systemd-resolved
# (confirmed live via `resolvectl status`) -- the only missing piece is
# /etc/resolv.conf actually deferring to resolved's stub, since
# nsswitch.conf's plain "dns" module (not "resolve") reads this file
# directly rather than talking to resolved over dbus.
# DefaultDependencies=no + WantedBy=sysinit.target (not multi-user.target)
# is required, not stylistic: systemd-resolved.service itself sets
# DefaultDependencies=no and is WantedBy=sysinit.target. This unit
# originally lived at the (default-dependencies, multi-user.target) layer
# with only `Before=systemd-resolved.service` connecting it to resolved --
# confirmed live that systemd detects this as an ordering cycle (sysinit
# .target implicitly precedes multi-user.target, but Before= here asked
# resolved, itself WantedBy=sysinit.target, to wait on a multi-user.target
# unit) and silently deletes systemd-resolved.service's start job to break
# the cycle, so resolved simply never started. Living in the same layer as
# resolved removes the conflicting implicit ordering entirely.
DefaultDependencies=no
Before=sysinit.target systemd-resolved.service
ConditionPathIsSymbolicLink=!/etc/resolv.conf

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'rm -f /etc/resolv.conf && ln -s /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf'
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
