[Unit]
Description=Point /etc/resolv.conf at systemd-resolved's stub (Issue #11/#31)
# VM boot path only. The rootfs carries whatever /etc/resolv.conf `docker
# build` baked in (scoped to the build host's own network namespace), and
# nothing re-mounts it at VM boot. DNS server addresses themselves come from
# systemd-networkd's DHCP client (runtime/vm-dhcp.network) feeding
# systemd-resolved; this unit only points /etc/resolv.conf at resolved's stub,
# since nsswitch.conf's "dns" module reads that file directly.
#
# DefaultDependencies=no + WantedBy=sysinit.target is required, not stylistic:
# moving this unit to the multi-user.target layer makes systemd detect an
# ordering cycle against systemd-resolved (itself WantedBy=sysinit.target) and
# silently delete resolved's start job, so resolved never starts at all.
# Rationale and the alternatives that were tried:
# docs/adr/0051-resolv-conf-fixed-at-vm-boot-in-sysinit-layer.md
DefaultDependencies=no
Before=sysinit.target systemd-resolved.service
ConditionPathIsSymbolicLink=!/etc/resolv.conf

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'rm -f /etc/resolv.conf && ln -s /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf'
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
