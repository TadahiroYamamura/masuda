[Unit]
Description=Generate missing OpenSSH host keys (Issue #31 M5-5)
# The openssh-server package's own host-key generation (ssh-keygen -A) runs
# once, as an apt postinst maintainer script, not as a systemd unit -- confirmed
# live: with no host keys present, ssh.service just fails outright ("sshd -t"
# in its ExecStartPre has nothing to test). The Dockerfile deletes the keys
# baked in at that postinst step on purpose (so every VM doesn't share the
# same host identity); this unit is what actually regenerates them, once, on
# a VM's first boot.
Before=ssh.service
ConditionPathExists=!/etc/ssh/ssh_host_rsa_key

[Service]
Type=oneshot
ExecStart=/usr/bin/ssh-keygen -A
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
