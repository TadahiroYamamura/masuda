{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Bash(cat .env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(sed * .env*)",
      "Bash(vi .env*)",
      "Bash(vim .env*)",
      "Bash(nano .env*)"
    ]
  }
}
